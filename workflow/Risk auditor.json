      "id": "1f7928b3-07d0-40f0-b886-25b866e55f4d",
      "name": "Aggregate"
    },
    {
      "parameters": {
        "jsCode": "const firstInput = $input.first().json;\nconst projectList = firstInput.data || [];\n\nlet masterMarkdown = \"🛡️ EXECUTIVE DELIVERY AUDIT — MASTER BRIEFING\\n\";\nmasterMarkdown += `Audit Date: ${new Date().toISOString().split('T')[0]}\\n\\n`;\nmasterMarkdown += \"========================================\\n\\n\";\n\nfor (const projData of projectList) {\n  const projectName = (projData.project || \"UNKNOWN\").toUpperCase();\n  \n  let reportText = (projData.report_markdown || \"No report data found.\")\n    .replace(/^#+\\s/gm, '')         \n    .replace(/\\*\\*(.*?)\\*\\*/g, '$1') \n    .replace(/__(.*?)__/g, '$1')     \n    .replace(/>\\s?/g, '')            \n    .replace(/---\\n?/g, '\\n');       \n\n  masterMarkdown += `PROJECT: ${projectName}\\n`;\n  masterMarkdown += reportText;\n  masterMarkdown += \"\\n\\n========================================\\n\\n\";\n}\n\nreturn [{\n  json: {\n    master_title: `🛡️ Executive Briefing — All Projects [${new Date().toISOString().split('T')[0]}]`,\n    master_markdown: masterMarkdown\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        384
      ],
      "id": "25538f4a-2fbc-48c6-8098-5c80c2a436ef",
      "name": "Create a master report"
    },
    {
      "parameters": {
        "pageId": {
          "__rl": true,
          "value": "3b86e3e41548806cbaa3d8f10a5b5ab3",
          "mode": "id"
        },
        "title": "={{ $json.master_title }}",
        "options": {}
      },
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        1392,
        496
      ],
      "id": "e963c5ef-6fc6-47ac-95c6-63687b9092c1",
      "name": "Create report page in Notion",
      "credentials": {
        "notionApi": {
          "id": "qNNrMt0J1jDlYZ0O",
          "name": "Akansha Notion"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 1. Get the Page ID from the Notion node right before this\nconst pageId = $('Create report page in Notion').first().json.id;\n\n// 2. Pull the master markdown from the report-building node\nconst masterMarkdown = $('Create a master report').first().json.master_markdown || \"\";\n\nconst MAX_CHARS = 1800;\n\nfunction splitIntoSafeChunks(text, maxChars) {\n  const chunks = [];\n  let remaining = text.trim();\n  while (remaining.length > 0) {\n    if (remaining.length <= maxChars) {\n      chunks.push(remaining);\n      break;\n    }\n    let splitAt = remaining.lastIndexOf('. ', maxChars);\n    if (splitAt === -1 || splitAt < maxChars * 0.5) {\n      splitAt = maxChars;\n    } else {\n      splitAt += 1;\n    }\n    chunks.push(remaining.slice(0, splitAt).trim());\n    remaining = remaining.slice(splitAt).trim();\n  }\n  return chunks;\n}\n\nconst paragraphs = masterMarkdown.split('\\n\\n').filter(p => p.trim() !== '');\nlet safeChunks = [];\n\nfor (const p of paragraphs) {\n  safeChunks = safeChunks.concat(splitIntoSafeChunks(p, MAX_CHARS));\n}\n\nreturn safeChunks.map(chunkText => ({\n  json: {\n    page_id: pageId,\n    chunk_text: chunkText\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
